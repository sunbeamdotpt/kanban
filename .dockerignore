.integration/*
!.integration/openfga-model.json

# Coverage / profiling artifacts
coverage*.lcov
build_rs_cov.profraw
sunbeam.yaml

# Docker files themselves
Dockerfile
.dockerignore

# Editor / OS files
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/
*.iml

# Local environment / secrets
.env
.env.*
*.local
